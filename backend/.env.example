# Supabase Project Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Direct PostgreSQL Database Connection String (for SQLAlchemy)
# Using IPv4-compatible pooler hostname from Supabase
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# LLM Configurations
DEV_MODE=False
PRIMARY_PROVIDER=gemini

# 1. Google Gemini Settings (Primary Multi-Key Pool with Instant Failover PK1..PK5)
GEMINI_API_KEY_1=AIzaSy...
GEMINI_API_KEY_2=AIzaSy...
GEMINI_API_KEY_3=AIzaSy...
GEMINI_API_KEY_4=AIzaSy...
GEMINI_API_KEY_5=AIzaSy...
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. NVIDIA Nemotron Settings (via OpenRouter Fallback)
NVIDIA_API_KEY=sk-or-v1-...
NVIDIA_BASE_URL=https://openrouter.ai/api/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Security
SECRET_KEY=generate_a_random_32_byte_hex_string_here
SINGLE_DEVICE_LOGIN=True
SUBMISSION_COOLDOWN_SECONDS=0
MAX_RPM_PER_USER=10
CORS_ORIGINS=*

# Seeded user credentials (read by seed.py at first startup)
ADMIN_PASSWORD=admin_secure_password_123
TEST_TEAM_PASSWORD=password

